#include <bits/stdc++.h>
using namespace std;
 
int main() {
    string s;
    cin >> s;
 
    string result = "";
 
    for (int i = 0; i < s.length(); ) {
        if (s.substr(i, 3) == "WUB") {
            if (!result.empty() && result.back() != ' ')
                result += ' ';
            i += 3;
        } else {
            result += s[i];
            i++;
        }
    }
 
    if (!result.empty() && result.back() == ' ')
        result.pop_back();
 
    cout << result;
    return 0;
}
